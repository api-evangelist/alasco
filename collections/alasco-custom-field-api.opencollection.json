{
  "opencollection": "1.0.0",
  "info": {
    "name": "CAPEX Annual Consumption Custom Field API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "Custom Field",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Custom Fields By Contract",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.alasco.de/capex/v1/contracts/:contract_id/custom_fields/",
            "params": [
              {
                "name": "contract_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "cursor[position]",
                "value": "",
                "type": "query",
                "description": "\nList endpoint responses are paginated in the Alasco API. By calling the endpoint without the\npagination parameter you will receive the first page. If not all elements fit on one page there will\nbe a `next` link provided in the response's `links` object. By calling this link you will receive\nthe next page.\n"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-API-KEY",
              "value": "{{X-API-KEY}}",
              "placement": "header"
            }
          },
          "docs": "Get Custom Fields By Contract"
        },
        {
          "info": {
            "name": "Get Custom Fields By Project",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.alasco.de/capex/v1/projects/:project_id/custom_fields/",
            "params": [
              {
                "name": "project_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "cursor[position]",
                "value": "",
                "type": "query",
                "description": "\nList endpoint responses are paginated in the Alasco API. By calling the endpoint without the\npagination parameter you will receive the first page. If not all elements fit on one page there will\nbe a `next` link provided in the response's `links` object. By calling this link you will receive\nthe next page.\n"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-API-KEY",
              "value": "{{X-API-KEY}}",
              "placement": "header"
            }
          },
          "docs": "Get Custom Fields By Project"
        }
      ]
    }
  ],
  "bundled": true
}