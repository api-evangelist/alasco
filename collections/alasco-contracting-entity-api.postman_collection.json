      "name": "Contracting Entity",
      "description": {
        "content": "A **Contracting Entity** is the legal entity on your side that commissions contracts, holding company and commercial-register details. Names are unique per account, and entities can be created and updated through the API.",
        "type": "text/plain"
      },
