  "item": [
    {
      "id": "feb98df6-4fd2-466a-894e-d6e0191fe828",
      "name": "Contract Unit",
      "description": {
        "content": "A **Contract Unit** is a budget package within a **Project** (the FinCon counterpart of a CapEx Measure), carrying an initial budget and a lifecycle **state**. **Contracts** are assigned to a contract unit, and **Budget Shifts** move budget between units. Contract units can be created and updated through the API.",
        "type": "text/plain"
      },
