            "params": [
              {
                "name": "building_uuid",
                "value": "",
                "type": "path"
              },
              {
                "name": "meter_uuid",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "X-API-KEY",
              "value": "{{X-API-KEY}}",
              "placement": "header"
            }
          },
          "docs": "Create Utility Meter Reading"
        },
        {
