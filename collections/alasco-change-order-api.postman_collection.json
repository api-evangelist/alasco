    {
      "id": "0466315a-084e-474e-b8b1-517ec970fceb",
      "name": "Change Order",
      "description": {
        "content": "A **Change Order** is a formal amendment to a **Contract** - a cost or scope change - carrying claimed, audited and approved amounts and an approval state. Change orders are read-only through this API and can hold **Documents**.",
        "type": "text/plain"
      },
